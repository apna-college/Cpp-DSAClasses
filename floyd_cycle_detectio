class Solution {
public:
    int findDuplicate(vector<int>& nums) {
        int s = nums[0];
        int f = nums[0];

        // First meeting point inside cycle
        do {
            s = nums[s];
            f = nums[nums[f]];
        } while (s != f);

        // Find entrance of cycle (duplicate number)
        s = nums[0];

        while (s != f) {
            s = nums[s];
            f = nums[f];
        }

        return s;
    }
};
